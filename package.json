{
  "name": "branch-reporting",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @repo/api prisma:generate",
    "db:migrate": "pnpm --filter @repo/api prisma:migrate",
    "db:seed": "pnpm --filter @repo/api prisma:seed"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  }
}